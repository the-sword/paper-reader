# 数据目录
LIB_ROOT=/home/lq016/paper-reader

# 服务
HOST=127.0.0.1
PORT=8787
AUTH_TOKEN=
PAPER_READER_SECRET=

# MinerU（阶段二才用）
MINERU_TOKEN=
MINERU_MODEL=vlm

# AI（阶段二/三才用，UI 配置优先）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 代理（可选）
# 需要代理访问外部 API 时填写，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7897
PAPER_READER_PROXY=
# 设为 1 时沿用系统环境变量中的代理；留空则忽略环境代理（推荐，可避免代理串解析问题）
PAPER_READER_USE_ENV_PROXY=
